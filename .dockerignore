# Keep the Docker build context lean and secret-free.
**/node_modules
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo
**/*.log

# Never ship real env files into an image; samples are fine.
.env
.env.*
!.env.example
!.env.production.example

# Not needed at build/runtime.
.git
.github
docs
prototype
tests
docker
**/.DS_Store
