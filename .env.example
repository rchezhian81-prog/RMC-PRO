# ---- PostgreSQL (cloud DB) ----
# Owner/superuser role — used ONLY for migrations & seed (bypasses RLS).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rmc
POSTGRES_USER=rmc
POSTGRES_PASSWORD=rmc
# Application role — non-superuser, SUBJECT to Row-Level Security (Doc 11 §6.4).
# The API runtime connects as this role so tenant isolation is DB-enforced.
APP_DB_USER=rmc_app
APP_DB_PASSWORD=rmc_app

# ---- Redis (cache / queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO / S3-compatible object storage ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rmc
S3_REGION=us-east-1

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Auth (Doc 11 §4) — replace in every real environment
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# CORS allowlist — comma-separated browser origins allowed to call the API.
# Leave UNSET in local dev (localhost:3000 / 127.0.0.1:3000 are allowed by default).
# Set explicitly in every deployed environment — the API is never opened to '*'.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ---- Production bootstrap (pnpm seed:prod) ----
# Non-destructive, idempotent. Creates ONE super admin only if SUPERADMIN_EMAIL is
# set and that email does not already exist. Password must be strong (>=12 chars,
# upper+lower+digit) and must NOT be a demo value. Leave unset to skip super-admin
# creation (catalogs/plans are still ensured).
# SUPERADMIN_EMAIL=admin@your-company.com
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Platform Super Admin

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
