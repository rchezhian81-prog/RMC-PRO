# ---- PostgreSQL (cloud DB) ----
# Owner/superuser role — used ONLY for migrations & seed (bypasses RLS).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rmc
POSTGRES_USER=rmc
POSTGRES_PASSWORD=rmc
# Application role — non-superuser, SUBJECT to Row-Level Security (Doc 11 §6.4).
# The API runtime connects as this role so tenant isolation is DB-enforced.
APP_DB_USER=rmc_app
APP_DB_PASSWORD=rmc_app

# ---- Redis (cache / queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO / S3-compatible object storage ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rmc
S3_REGION=us-east-1

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Auth (Doc 11 §4) — replace in every real environment
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
