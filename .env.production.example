# RMC Plant SaaS — PRODUCTION env SAMPLE (Phase-1 pilot). TEMPLATE ONLY.
#
# Copy to `.env.production` (git-ignored) and replace EVERY placeholder before
# deploying. Do NOT commit the filled-in file. Generate secrets with a CSPRNG,
# e.g.  openssl rand -base64 36
#
# <DOMAIN> is a placeholder — swap in the real registered domain everywhere
# (e.g. mixnovas.com). Host scheme (5 hosts, one SAN cert):
#   <DOMAIN>       (apex) = 301 redirect to app.<DOMAIN>
#   www.<DOMAIN>          = 301 redirect to app.<DOMAIN>
#   app.<DOMAIN>          = web portal (tenant + super-admin)
#   api.<DOMAIN>          = API backend
#   admin.<DOMAIN>        = super-admin alias -> same web app (/admin)

# ---- Domain ----
# nginx expands ${DOMAIN} from this value at container start (envsubst), so the
# reverse-proxy config needs no host-side edit. e.g. DOMAIN=mixnovas.com
DOMAIN=<DOMAIN>

# ---- Image source ----
# IMAGE_TAG: which tag to run. Prefer the git SHA the CI workflow built (immutable),
# not 'latest'. e.g. IMAGE_TAG=9463c1d
IMAGE_TAG=latest
# IMAGE_TAG_WEB (optional): run the WEB image on a different tag than api/IMAGE_TAG.
# Used to flip the UI V2 skin independently — set to the flag-ON preview image
# (e.g. IMAGE_TAG_WEB=0e5e132-uiv2), `pull web && up -d web`. Clear it to roll the
# skin back to IMAGE_TAG (flag OFF) in seconds. Leave unset for normal deploys.
# IMAGE_TAG_WEB=
# Leave IMAGE_REPO_* unset to BUILD images locally on the host (rmc-api / rmc-web).
# To PULL CI-built images from GHCR instead (recommended — VM3 never builds), set both
# to the registry path, set IMAGE_TAG to the built SHA, then:
#   docker compose --env-file .env.production -f docker/docker-compose.prod.yml pull
#   docker compose --env-file .env.production -f docker/docker-compose.prod.yml up -d
# IMAGE_REPO_API=ghcr.io/rchezhian81-prog/rmc-pro/rmc-api
# IMAGE_REPO_WEB=ghcr.io/rchezhian81-prog/rmc-pro/rmc-web

# ---- PostgreSQL ----
# Owner/superuser role — migrations & seed only (bypasses RLS).
POSTGRES_DB=rmc
POSTGRES_USER=rmc_owner
POSTGRES_PASSWORD=__REPLACE_WITH_STRONG_SECRET__
# Application role — NON-superuser, subject to Row-Level Security.
# Created by the Init migration; the API runtime connects as this role.
APP_DB_USER=rmc_app
APP_DB_PASSWORD=__REPLACE_WITH_DIFFERENT_STRONG_SECRET__

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- MinIO / S3-compatible object storage ----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=__REPLACE__
S3_SECRET_KEY=__REPLACE_WITH_STRONG_SECRET__
S3_BUCKET=rmc
S3_REGION=us-east-1

# ---- API auth (JWT) — generate two DIFFERENT random secrets ----
# REQUIRED in production: the API REFUSES TO BOOT if either is unset, left at the
# built-in dev default, or shorter than 16 chars (prevents forgeable tokens).
# Generate with: openssl rand -base64 36
JWT_ACCESS_SECRET=__REPLACE_WITH_RANDOM_32B__
JWT_REFRESH_SECRET=__REPLACE_WITH_DIFFERENT_RANDOM_32B__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ---- Refresh-token cookie (httpOnly; safer than a localStorage token) ----
# The API issues the refresh token as an httpOnly cookie AND in the body (so old
# clients keep working). Defaults suit the cross-site setup app.<domain> ->
# api.<domain> (SameSite=None + Secure, host-only api cookie). For same-origin or
# local http, relax them: AUTH_COOKIE_SAMESITE=lax and AUTH_COOKIE_SECURE=false.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=

# ---- Observability ----
# The API emits one structured JSON log line per request (method, path, status,
# latency, tenant/user) to stdout — greppable in `docker logs` and ready to ship
# to a log aggregator. Set REQUEST_LOG=off to silence it.
# REQUEST_LOG=off

# ---- Provisioning strictness (optional; recommended ON once fully provisioned) --
# When '1', a tenant with no module rows / no plan is treated as having NOTHING
# enabled (module + limit checks fail CLOSED) instead of everything. Leave unset
# during initial rollout so a provisioning gap never takes a live plant off the
# air; turn it on after confirming every tenant has a plan + modules (seed:prod
# back-fills them). Default: off.
# PROVISIONING_STRICT=1

# ---- Multi-agent AI (optional; INBUILT by default, no subscription) ----
# The 5 agents always run their DETERMINISTIC paths (KPIs, alerts, compliance
# prep, approvals) at zero cost with nothing set here. The optional reasoning /
# chat layer (`/agents/:name/ask`) runs on a model YOU host — no per-token bill,
# data never leaves your box. See docs/deployment/INBUILT-LLM-RUNBOOK.md.
#
# Backend: 'local' (default, self-hosted) or 'anthropic' (opt-in, paid).
AGENT_LLM_PROVIDER=local
# INBUILT model — point this at your local server's OpenAI-compatible endpoint.
# Presence of the base URL turns the reasoning layer ON; unset = deterministic.
#   Ollama:   http://127.0.0.1:11434/v1   (ollama pull qwen2.5:7b-instruct)
#   llama.cpp http://127.0.0.1:8080/v1
# AGENT_LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_LLM_LOCAL_MODEL=qwen2.5:7b-instruct
# AGENT_LLM_LOCAL_API_KEY=          # only if your server requires a bearer
# AGENT_LLM_LOCAL_TIMEOUT_MS=120000 # CPU inference is slow; default 120s
#
# HOSTED opt-in (metered/paid; sends prompts to Anthropic). Only used when
# AGENT_LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# AGENT_LLM_MODEL=claude-opus-5

# ---- India GST live transmission (optional; OFF by default) ----
# The Automation agent PREPARES IRN / e-way payloads for human approval today.
# To also TRANSMIT an approved action, implement nic.provider.ts against your GSP
# (docs/deployment/INTEGRATION-RUNBOOK-*) and switch this on. Default 'disabled'
# keeps prepare-only. 'fake' is an offline test provider — never for production.
GST_PROVIDER=disabled
# GST_ENV=sandbox                        # sandbox | production
# GST_IRP_BASE_URL=
# GST_EWB_BASE_URL=
# GST_GSP_CLIENT_ID=
# GST_GSP_CLIENT_SECRET=
# GST_RSA_PUBLIC_KEY_PEM=                 # portal public key (PEM), for direct NIC

# ---- CORS allowlist (browser origins that may call the API) ----
# Comma-separated; both portal hosts (app + admin). Never '*'.
CORS_ORIGINS=https://app.<DOMAIN>,https://admin.<DOMAIN>

# ---- Web build-time API origin (baked into the client bundle) ----
NEXT_PUBLIC_API_URL=https://api.<DOMAIN>
# UI V2 ("Deep Violet Matte") rollout flag — PRESENTATION ONLY, build-time.
# MUST stay empty (OFF) in production until UI V2 is built + separately approved.
# Only "1"/"true" turn it on; anything else is OFF. To activate later, set this AND
# pass NEXT_PUBLIC_UI_V2 as a web-image build-arg, then rebuild. Never gates
# modules/permissions/routes. See docs/ui/UI-V2-ROLLOUT.md
NEXT_PUBLIC_UI_V2=

# ---- Production bootstrap (pnpm seed:prod / migrate one-shot) ----
# Creates ONE super admin if this email does not already exist. Password must be
# strong (>=12 chars, upper+lower+digit) and must NOT be a demo value.
SUPERADMIN_EMAIL=admin@<DOMAIN>
SUPERADMIN_PASSWORD=__REPLACE_WITH_STRONG_SECRET__
SUPERADMIN_NAME=Platform Super Admin

# ---- Off-box backups (recovery-critical: on-box copies die with the box) ----
# Every pg-backup.sh dump is copied off VM3 when ONE of these is set. Backblaze
# B2 via rclone is the configured target — see scripts/backup/README.md to set up
# the `b2` rclone remote, then point this at your bucket (optionally a subfolder):
RMC_OFFBOX_RCLONE=b2:rmc-offbox-backups
# ...or copy to a separate SSH host instead (leave RMC_OFFBOX_RCLONE unset):
# RMC_OFFBOX_SCP=backup@host:/srv/rmc-backups

# ---- Ops alerting (optional but recommended) ----
# A generic webhook (Slack/Discord/Telegram-bridge/n8n) that receives {"text":...}
# POSTs. Used by health-check.sh, the restore drill, and — importantly — a FAILED
# off-box backup copy, so a backup that never leaves the box is never silent.
# RMC_ALERT_WEBHOOK=https://hooks.example.com/...
#
# The in-app ops alerter (server 5xx + operational conditions like GST portal
# auth failures and dead-lettered execution jobs) POSTs a {"text":...} body to
# ALERT_WEBHOOK_URL when set, and ALWAYS logs a {"level":"alert"} line either way.
# Alerts are deduped per-signature and circuit-broken so a storm pages once.
# ALERT_WEBHOOK_URL=https://hooks.example.com/...
# ALERT_MIN_STATUS=500            # only HTTP status >= this raises a 5xx alert
# ALERT_DEDUP_WINDOW_MS=300000    # same signature at most once per window (5 min)
# ALERT_MAX_PER_WINDOW=60         # circuit breaker: max alerts per window

# ---- GST e-invoice / e-way (IRP) integration — held for deployment ----
# The live NIC/GSP adapter is OFF by default (prepare-only). Turn it on ONLY
# after sandbox verification (see docs/deployment/INTEGRATION-RUNBOOK-01/02).
#   disabled (default) → prepare-only, nothing transmitted
#   fake               → deterministic offline provider (demos/tests, never prod)
#   nic | gsp          → the live adapter
# GST_PROVIDER=disabled
# GST_IRP_BASE_URL=https://<your-gsp-irp-host>
# GST_EWB_BASE_URL=https://<your-gsp-eway-host>   # optional; defaults to IRP host
# GST_GSP_CLIENT_ID=__FROM_YOUR_GSP__
# GST_GSP_CLIENT_SECRET=__FROM_YOUR_GSP__
# GST_RSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# GST_IRP_MAX_RETRIES=2                             # transient-failure backoff retries

# Durable execution queue (GW-1). Approving a GST action always enqueues a job;
# it runs via the synchronous execute endpoint (operator/worker call) and/or the
# in-process background worker below. The worker is OFF by default — turn it on to
# drain the queue automatically. Safe across multiple nodes (atomic job claim).
# GST_WORKER_ENABLED=false
# GST_WORKER_INTERVAL_MS=5000                       # poll cadence when the worker is on

# Master key that encrypts each tenant's stored GST-portal PASSWORD at rest
# (AES-256-GCM). REQUIRED to store/use live credentials; without it, credential
# save/use is blocked with a clear error. Provide 32 bytes as 64 hex chars or
# base64 of 32 bytes. Generate: `openssl rand -hex 32`. Keep it ONLY here — never
# in the DB, repo, image, or logs; rotating it needs a re-encrypt (key version).
# GST_CRED_ENC_KEY=__REPLACE_WITH_openssl_rand_hex_32__
