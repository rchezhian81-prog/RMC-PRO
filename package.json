{
  "name": "rmc-pro",
  "version": "0.1.0",
  "private": true,
  "description": "RMC Plant SaaS — multi-tenant Ready Mix Concrete plant operating system",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @rmc/shared build && turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "c8 node --test packages/shared/test/unit/*.test.mjs apps/api/test/unit/*.test.mjs",
    "test:e2e": "node --experimental-sqlite tests/run.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "c8": "^12.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
